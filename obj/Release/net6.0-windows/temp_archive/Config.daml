<ArcGIS defaultAssembly="HK_AREA_SEARCH.dll" defaultNamespace="HK_AREA_SEARCH" xmlns="http://schemas.esri.com/DADF/Registry" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://schemas.esri.com/DADF/Registry file:///D:/arcgispro/install/bin/ArcGIS.Desktop.Framework.xsd">
  <AddInInfo id="{5d4182cc-7841-4855-b9a3-3df249e8d7d6}" version="1.0" desktopVersion="3.0.36056">
    <Name>HK_AREA_SEARCH</Name>
    <Description>A comprehensive site selection tool for Hong Kong area analysis, including constraint filtering, distance calculation, and rating evaluation.</Description>
    <Image>Images\AddinDesktop32.png</Image>
    <Author>Yuecheng Li，Zhongzhu Liu</Author>
    <Company>Acme</Company>
    <Date>2025/11/12 14:42:25</Date>
    <Subject>Map Authoring, Geoprocessing</Subject>
    <!-- Note subject can be one or more of these topics:
                    Content, Framework, Editing, Geodatabase, Geometry, Geoprocessing, Layouts, Map Authoring, Map Exploration -->
  </AddInInfo>
  <modules>
    <insertModule id="HK_AREA_SEARCH_Module" className="Module1" autoLoad="false" caption="Module1">
      <!-- uncomment to have the control hosted on a separate tab-->
      <tabs>
        <!--<tab id="HK_AREA_SEARCH_Tab1" caption="New Tab">
          <group refID="HK_AREA_SEARCH_Group1"/>
        </tab>-->
      </tabs>
      <groups>
        <!-- comment this out if you have no controls on the Addin tab to avoid
              an empty group-->
        <group id="HK_AREA_SEARCH_Group1" caption="Click to Open" appearsOnAddInTab="true">
          <!-- host controls within groups -->
          <button refID="HK_AREA_SEARCH_main_dockpane_ShowButton" size="large" />
        </group>
      </groups>
      <controls>
        <button id="HK_AREA_SEARCH_main_dockpane_ShowButton" 
                caption="GeoSelecta HK" 
                className="main_dockpane_ShowButton" 
                loadOnClick="true" 
                smallImage="Images\HKicon64.png" 
                largeImage="Images\HKicon128.png">
          <tooltip heading="Show Dockpane">Show Dockpane<disabledText /></tooltip>
        </button>
      </controls>
      <dockPanes>
        <dockPane id="HK_AREA_SEARCH_main_dockpane" 
				  caption="HK Site Selection Toolkit" 
				  className="main_dockpaneViewModel" 
				  dock="group" 
				  dockWith="esri_core_projectDockPane">
          <content className="main_dockpaneView" />
        </dockPane>
      </dockPanes>
    </insertModule>
  </modules>
</ArcGIS>